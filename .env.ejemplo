# ---------------------------------------------------------------------------
# RutaVivaMantaro - plantilla de variables de entorno
#
# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube al
# repositorio (esta en .gitignore). Este archivo si se sube, pero sin secretos.
#   Windows PowerShell:  Copy-Item .env.ejemplo .env
# ---------------------------------------------------------------------------

# --- Base de datos PostgreSQL + PostGIS -----------------------------------
# Estos tres valores los consume tanto docker-compose.yml como el backend.
POSTGRES_USUARIO=rutaviva
POSTGRES_CONTRASENA=cambia_esta_contrasena
POSTGRES_BASE=rutavivamantaro
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432

# --- Aplicacion ------------------------------------------------------------
ENTORNO=desarrollo
# Clave para firmar los tokens JWT. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=genera_una_clave_larga_y_aleatoria
MINUTOS_EXPIRACION_TOKEN=1440

# --- Ollama (asistente conversacional, corre en local) ---------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b-instruct

# --- Interruptores de modelo (regla 1.6 del PROMPT_MAESTRO) ----------------
# Cada funcionalidad con IA tiene su alternativa por reglas explicitas.
# Poner en false hace que el sistema use la alternativa por reglas.
USAR_MODELO_RECOMENDACION=true
USAR_MODELO_AFLUENCIA=true
USAR_MODELO_SENTIMIENTO=true

# --- Frontend --------------------------------------------------------------
# Vite solo expone al navegador las variables con prefijo VITE_.
VITE_URL_API=http://localhost:8000
