            "title": "Hora Fin"
          },
          "guardar": {
            "type": "boolean",
            "title": "Guardar",
            "default": false
          },
          "titulo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Titulo"
          }
