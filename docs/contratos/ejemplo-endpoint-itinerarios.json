{
  "openapi": "3.1.0",
  "info": {
    "title": "RutaVivaMantaro",
    "description": "API de la plataforma de turismo inteligente para la Ruta del Valle del Mantaro (Junin, Peru). Proyecto del curso Procesos de Software, Universidad Continental.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/itinerarios": {
      "post": {
        "tags": [
          "itinerarios"
        ],
        "summary": "Arma el itinerario de un día para una preferencia",
        "description": "Recomienda, ordena y horaria las paradas de un día.\n\nQué vía se usa lo decide ``USAR_MODELO_RECOMENDACION`` del ``.env``: con\n``true`` optimiza con OR-Tools, con ``false`` usa el vecino más cercano. El\ncampo ``generado_por`` de la respuesta deja constancia de cuál fue.",
        "operationId": "armar_itinerario_api_itinerarios_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudItinerario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaItinerario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvisoPublico": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo",
            "examples": [
              "altitud"
            ]
          },
          "parametros": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parametros",
            "examples": [
              {
                "metros": 3706
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "codigo"
        ],
        "title": "AvisoPublico",
        "description": "Un aviso, sin redactar.\n\nLa interfaz lo convierte en frase con ``t('avisos.' + codigo, parametros)``."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
