            "title": "Esfuerzo"
          },
          "hay_tramos_estimados": {
            "type": "boolean",
            "title": "Hay Tramos Estimados"
          },
          "avisos": {
            "items": {
              "$ref": "#/components/schemas/AvisoPublico"
            },
            "type": "array",
            "title": "Avisos"
          }
